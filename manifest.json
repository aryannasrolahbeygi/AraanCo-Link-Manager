{
  "manifest_version": 3,
  "name": "AraanCo Link Manager",
  "version": "1.2.0",
  "description": "Save, organize, search, back up, and optionally sync links across devices. English and Persian interface.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "key": ""
}
